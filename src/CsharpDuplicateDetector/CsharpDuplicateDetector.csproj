<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>CsharpDuplicateDetector</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<PackAsTool>true</PackAsTool>
		<ToolCommandName>csharp-duplicate-detector</ToolCommandName>
		<PackageId>csharp-duplicate-detector</PackageId>
		<Version>1.0.0</Version>
		<Authors>Ter-jeff</Authors>
		<Description>
			Near-duplicate C# code detector. Clean-room reimplementation of the
			csharp-duplicate-detector CLI contract (docopt usage, CSV/JSON output)
			built on Roslyn tokenization and Jaccard similarity over token
			sets/multisets, split by method, class, or file.
		</Description>
		<PackageType>DotnetTool</PackageType>
		<SatelliteResourceLanguages>es</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="docopt.net" Version="0.6.1.10" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
	</ItemGroup>

</Project>
