<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/Ter-jeff/index.json" />
    <!--
      Local fallback so `dotnet tool restore` can be validated against
      csharp-duplicate-detector/slt-csharp-metrics before their .nupkg has
      been pushed to main and published to the github feed above by
      publish-packages.yml. Safe to remove once that first publish has run;
      the github source resolves the same packages afterwards.
    -->
    <add key="nuget-local-mirror" value="../../feed" />
  </packageSources>
</configuration>
